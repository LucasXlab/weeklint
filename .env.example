# Weeklint has no API keys and makes no network calls.
# These are the only environment variables it reads.

# Config file path. Relative paths resolve from the current directory.
WEEKLINT_CONFIG=./weeklint.yaml

# Override "now" for reproducible output (ISO 8601 with offset).
# WEEKLINT_NOW=2026-11-02T09:00:00+08:00

# Disable ANSI colour in human output.
# WEEKLINT_NO_COLOR=1

# Include a traceback on unexpected internal errors (never secrets).
# WEEKLINT_DEBUG=1
